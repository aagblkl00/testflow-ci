# ===== TestFlow CI 配置示例 =====
# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，不要提交。

# --- 数据底座 ---
# 开发模式（本机无 Docker 时直接用）
DATABASE_URL=sqlite:///./testflow.db
# 正式模式（docker compose up 之后切这一行）
# DATABASE_URL=postgresql+psycopg://testflow:testflow@localhost:5432/testflow

# --- 执行模式 ---
# inline = 进程内同步执行（无需 Redis，M1 默认）
# celery = 投递到 Celery Worker（需要 Redis）
EXECUTOR_MODE=inline
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- 证据存储 ---
STORAGE_DIR=./storage

# --- Playwright ---
# 留空则使用系统默认缓存目录。
# 本机已下好 Chromium，指向它可免于重新下载：
# PLAYWRIGHT_BROWSERS_PATH=<本机Chromium缓存目录>
PLAYWRIGHT_BROWSERS_PATH=
PLAYWRIGHT_HEADLESS=true

# --- 证据录制（M2）---
# video 与 HAR 都是 context 级录制，只在 context/page 关闭时才写盘。
# 不想让每此执行都产生几十 MB 证据时可以关掉。
PLAYWRIGHT_RECORD_VIDEO=true
PLAYWRIGHT_RECORD_HAR=true

# --- 认证 ---
# 生产环境务必改成随机长串
TESTFLOW_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# --- AI（M5 失败分析用；留空 = AI 功能整体关闭，不影响测试执行）---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Provider 名：openai_compatible（默认，任何兼容 /chat/completions 的服务都能接）/ fake（仅测试）
AI_PROVIDER=openai_compatible
AI_TIMEOUT=60
AI_MAX_TOKENS=1200
AI_MAX_RETRIES=1
# 除了 UNKNOWN 之外，还允许哪些规则命中时进 AI（逗号分隔的 rule_id）。
# 留空 = 只有 UNKNOWN 进 AI —— 这是推荐配置，别把确定性结论也送去重判。
AI_ANALYSIS_REQUIRED_RULES=
# Run 结束后是否自动分析（AI 未配置时该开关无效）
AI_AUTO_ANALYZE=true

# --- 企业微信通知（M5；留空 = 不发通知，告警照常记录）---
WECOM_WEBHOOK_URL=
# 群机器人的 key 在 URL 里，这个额外 secret 用于自建应用形态；两者都会被脱敏
WECOM_WEBHOOK_SECRET=
# 通知总开关。计划自身的「发送企业微信通知」也要打开才会真的发（默认静默）
NOTIFICATION_ENABLED=true
NOTIFICATION_MAX_ATTEMPTS=3

# M6-A：Artifact 内容签名 URL 的有效期（秒）。浏览器图片/视频/下载链接不带 Bearer，
# 所以用短时签名；到期后前端需重新从 API 获取 URL。
ARTIFACT_URL_TTL_SECONDS=300

# M6-B：全局 Artifact 保留天数。只影响「已结束 Run」的证据；
# 第一版仅支持管理员 Preview / Apply，不做自动删除。
ARTIFACT_RETENTION_DAYS=30

# --- 对外访问地址（通知里的详情链接前缀）---
PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- M4：CI 触发凭据 ---
# 留空 = CI 接口整体关闭（返回 503），不会变成无认证的开放入口。
# 生产环境请用足够长的随机串，并且只放在 CI 的 Secret 里，不要写进 .gitlab-ci.yml。
TESTFLOW_CI_TOKEN=
